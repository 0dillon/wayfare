{
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go doc:*)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(gofmt -l .)",
      "Bash(gofmt -w .)",
      "Bash(golangci-lint run:*)",
      "Bash(make:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "WebFetch(domain:developers.stellar.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
